.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
.env
.idea/
.vscode/

# Local (test-mode) chunk storage -- never source, always regenerated.
.localChunkStore/
tests/data/.localStore/

# Secrets: service account keys, API keys, credentials -- NEVER commit.
# Scoped deliberately: a bare *.json would also hide legitimate config.
keys/
*serviceAccount*.json
*-adminsdk-*.json
*credentials*.json
.env.local


# Claude Code runtime artefacts. The skills directory is source and is tracked.
.claude/scheduled_tasks.lock
